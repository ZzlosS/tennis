# Copy to .env and fill in. The server refuses to start if a required value is missing.

# HTTP port (default 8787)
PORT=8787

# Redis Stack (needs the Search and JSON modules), default redis://localhost:6379
REDIS_URL=redis://localhost:6379

# REQUIRED. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Access token lifetime (default 15m) and refresh token lifetime in days (default 30)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# bcrypt cost factor (default 12)
BCRYPT_ROUNDS=12

# Comma-separated list of web origins allowed to call the API from a browser.
# Empty means no cross-origin access. Expo web dev server runs on 8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Requests one client may make a minute (in total, and to /v1/auth/*)
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
# Proxies in front of the API; set to 1 behind a load balancer so the client's IP is the one that is limited
TRUST_PROXY=0
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Links in emails (password reset, email check) point to the app here
APP_URL=http://localhost:8081
# Sending email: an API key from resend.com and a sender address on a domain verified there.
# Without a key, emails are only written to the log.
RESEND_API_KEY=
MAIL_FROM=Tennis <onboarding@resend.dev>

# Push notifications go through Expo. The token is only needed if enhanced push security is on in your Expo project.
EXPO_ACCESS_TOKEN=
# Players get a reminder this many hours before a booking starts
REMINDER_HOURS_BEFORE=2
