# Copy to .env and fill in. The server refuses to start if a required value is missing.

# HTTP port (default 8787)
PORT=8787

# Redis Stack (needs the Search and JSON modules), default redis://localhost:6379
REDIS_URL=redis://localhost:6379

# REQUIRED. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Access token lifetime (default 15m) and refresh token lifetime in days (default 30)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# bcrypt cost factor (default 12)
BCRYPT_ROUNDS=12

# Comma-separated list of web origins allowed to call the API from a browser.
# Empty means no cross-origin access. Expo web dev server runs on 8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
