{
  "name": "tennis",
  "version": "1.0.0",
  "description": "",
  "main": "./build/server.js",
  "scripts": {
    "watch": "nodemon src/server.ts",
    "devv": "nodemon src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "format": "prettier --write src test",
    "start": "node build/server.js",
    "predev": "npm run spec",
    "prebuild": "npm run spec",
    "build": "tsc",
    "dev": "concurrently \"nodemon src/server.ts\" \"nodemon -x tsoa spec-and-routes\"",
    "grant-role": "ts-node src/scripts/grantRole.ts",
    "spec": "tsoa spec-and-routes",
    "pretest": "npm run spec",
    "pretypecheck": "npm run spec",
    "seed": "ts-node src/examples/insertData.ts",
    "mock": "prism mock openapi/v1.json --dynamic=false -p 4010"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "@types/node": "^18.14.1",
    "bcrypt": "^5.1.0",
    "class-validator": "^0.14.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "nodemon": "^2.0.20",
    "redis": "^4.7.1",
    "redis-om": "^0.4.7",
    "swagger-ui-express": "^5.0.0",
    "ts-node": "^10.9.1",
    "tsoa": "^6.6.0",
    "ulid": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^7.6.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^8.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.9"
  }
}
